{
    "name": "minos-moderation/client-php",
    "description": "The PHP client of the Wergiliusz gateway's B2B API for Minos forum plugins: webhook signature verification, payload reading, and a mock gateway for development",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "ext-curl": "*",
        "ext-mbstring": "*",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Minos\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Minos\\Mock\\": "mock-gateway/src/",
            "Minos\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
